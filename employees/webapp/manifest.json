{
  "_version": "1.84.0",
  "sap.app": {
    "id": "employees",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.23.0",
      "toolsId": "e2b94754-0bb2-4a7d-b574-8e5364f635d2"
    },
    "dataSources": {
      "mainService": {
        "uri": "/v2/northwind/northwind.svc/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "YSAPUI5_SRV_01": {
        "uri": "/sap/opu/odata/sap/YSAPUI5_SRV_01/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/YSAPUI5_SRV_01/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "ZEMPLOYEES_SRV": {
        "uri": "/sap/opu/odata/sap/ZEMPLOYEES_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/ZEMPLOYEES_SRV/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.147.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "employees.i18n.i18n"
        }
      },
      "northwind": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      },
      "incidence": {
        "dataSource": "YSAPUI5_SRV_01",
        "preload": true,
        "settings": {}
      },
      "employees": {
        "dataSource": "ZEMPLOYEES_SRV",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "employees.view",
        "async": true,
        "viewPath": "employees.view"
      },
      "routes": [
        {
          "name": "RouteMainView",
          "pattern": ":?query:",
          "target": [
            "TargetMainView"
          ]
        },
        {
          "name": "RouteNewEmployee",
          "pattern": "NewEmployee",
          "target": [
            "TargetNewEmployee"
          ]
        },
        {
          "name": "RouteOverviewEmployees",
          "pattern": "OverviewEmployees",
          "target":[
            "TargetOverviewEmployees"
          ]
        },
        {
          "name": "RouteMasterEmployee",
          "pattern": "MasterEmployee",
          "target": [
            "TargetMasterEmployee",
            "TargetDetailEmployee"
          ]
        },
        {
          "name": "RouteDetailEmployee",
          "pattern": "DetailEmployee",
          "target": [
            "TargetMasterEmployee",
            "TargetDetailEmployee"
          ]
        }
      ],
      "targets": {
        "TargetMainView": {
          "id": "MainView",
          "name": "MainView"
        },
        "TargetNewEmployee": {
          "id": "newEmployee",
          "name": "NewEmployee"
        },
        "TargetOverviewEmployees": {
          "id": "overviewEmployees",
          "name": "OverviewEmployees"
        },
        "TargetContainer": {
          "id": "containerEmployee",
          "name": "ContainerEmployee"
        },
        "TargetMasterEmployee": {
          "id": "masterEmployee",
          "name": "MasterEmployee",
          "parent": "TargetContainer",
          "controlId": "fcl-employee",
          "controlAggregation": "beginColumnPages"
        },
        "TargetDetailEmployee": {
          "id": "detailEmployee",
          "name": "DetailEmployee",
          "parent": "TargetContainer",
          "controlId": "fcl-employee",
          "controlAggregation": "midColumnPages"
        }
      }
    },
    "rootView": {
      "viewName": "employees.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
